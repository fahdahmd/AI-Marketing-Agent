# ==============================================================================
# AI Marketing Agent — environment variables
# Copy this file to .env and fill in values. Never commit .env.
# The app runs fully in development with mock providers when these are unset.
# ==============================================================================

# --- Core ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_marketing_agent?schema=public"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-long-random-string"
APP_URL="http://localhost:3000"

# --- AI provider ---
# When unset, the app automatically falls back to MockAIProvider.
AI_PROVIDER="mock" # "openai" | "mock"
OPENAI_API_KEY=
OPENAI_MODEL="gpt-4o-mini"
OPENAI_IMAGE_MODEL="dall-e-3"

# --- Billing (Paddle) ---
# When unset, the app automatically falls back to MockBillingProvider.
BILLING_PROVIDER="mock" # "paddle" | "mock"
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT="sandbox" # "sandbox" | "production"

PADDLE_STARTER_PRICE_ID=
PADDLE_GROWTH_PRICE_ID=
PADDLE_PRO_PRICE_ID=
PADDLE_AGENCY_PRICE_ID=

# --- Object storage (S3-compatible) ---
# When unset, the app falls back to local disk storage under .uploads/ (dev only).
STORAGE_PROVIDER="local" # "s3" | "local"
S3_ENDPOINT=
S3_REGION="auto"
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_URL=

# --- Social platforms (OAuth) ---
# When unset, the app uses MockSocialProvider for all platforms.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Google (Analytics / Search Console) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Background jobs ---
# When unset, jobs run inline (synchronously, in-process) instead of via BullMQ/Redis.
REDIS_URL=
